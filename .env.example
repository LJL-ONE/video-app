# ==========================================
# 视频项目环境变量示例
# 使用方法：复制为 .env 并按需修改
#   cp .env.example .env
# ==========================================

# ---------- Docker 镜像加速 ----------
# 留空使用 Docker Hub 官方源
# 国内推荐（任选其一）：
#   registry.cn-hangzhou.aliyuncs.com/
#   hub-mirror.c.163.com/library/
IMAGE_REGISTRY_PREFIX=

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=video_meeting
MYSQL_USER=root
MYSQL_PASSWORD=root123456

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-meeting
# 返回给前端的公开访问地址（需外部浏览器可访问）
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000/video-meeting

# ---------- JWT ----------
# 生产环境务必修改为随机长字符串
JWT_SECRET=video-meeting-server-secret-key-please-replace-in-production
JWT_EXPIRE=86400

# ---------- 后端服务 ----------
SERVER_PORT=8081
